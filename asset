
:root{--pc-blue:#1159df;--pc-cyan:#25c8ce;--pc-pink:#e72c91}
#pc-sync{position:fixed;left:10px;bottom:76px;z-index:9999;padding:7px 10px;border-radius:999px;font:800 10px Arial;background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;box-shadow:0 5px 16px #0002}
#pc-sync.wait{background:#fff7ed;color:#c2410c;border-color:#fed7aa}#pc-sync.off{background:#fff1f2;color:#be123c;border-color:#fecdd3}
.pc-today{padding:18px;border-radius:24px;background:linear-gradient(135deg,#0f172a,#1159df);color:white;box-shadow:0 14px 34px #1159df33;margin-bottom:16px}.pc-today h2{font-size:20px;font-weight:950}.pc-today-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.pc-today-item{padding:11px;border-radius:15px;background:#ffffff18;text-align:center}.pc-today-item b{display:block;font-size:20px}.pc-today-item small{font-size:8px;text-transform:uppercase;font-weight:900}
.pc-employee-focus{display:grid;gap:10px}.pc-employee-focus button{width:100%;padding:15px;border:1px solid #dbeafe;border-radius:18px;background:white;text-align:left;font-weight:900;color:#0f172a;box-shadow:0 7px 20px #0f172a0d}.dark .pc-employee-focus button{background:#17213b;color:#fff;border-color:#334155}.pc-employee-focus i{width:30px;color:var(--pc-blue)}
.pc-advanced{display:none!important}.pc-show-advanced .pc-advanced{display:block!important}.pc-toggle{width:100%;margin-top:10px;padding:10px;border-radius:14px;background:#eef2ff;color:#3730a3;font-size:10px;font-weight:900}
@media(max-width:520px){.pc-today-grid{grid-template-columns:repeat(2,1fr)}}

(function(){'use strict';
const VERSION='PREVY_CONSOLIDE_2026_09_03';
function q(s,r=document){return r.querySelector(s)}
function qa(s,r=document){return [...r.querySelectorAll(s)]}
function safeCount(key){try{const v=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(v)?v.length:0}catch(e){return 0}}
function installSync(){if(q('#pc-sync'))return;const b=document.createElement('div');b.id='pc-sync';document.body.appendChild(b);function update(){const off=!navigator.onLine,pending=safeCount('restev85_offline_queue');b.className=off?'off':pending?'wait':'';b.textContent=off?'Hors connexion':pending?pending+' élément(s) en attente':'Synchronisé'}addEventListener('online',update);addEventListener('offline',update);addEventListener('storage',update);setInterval(update,5000);update()}
function managerToday(){const m=q('#scr-manager');if(!m||q('#pc-manager-today'))return;const box=document.createElement('section');box.id='pc-manager-today';box.className='pc-today';box.innerHTML='<p style="font-size:9px;font-weight:900;text-transform:uppercase;color:#bae6fd">Tableau prioritaire</p><h2>Aujourd’hui</h2><p style="font-size:11px;color:#dbeafe">Les éléments nécessitant une décision ou un suivi.</p><div class="pc-today-grid"><div class="pc-today-item"><b id="pc-risk-count">0</b><small>Signalements</small></div><div class="pc-today-item"><b id="pc-action-count">0</b><small>Actions ouvertes</small></div><div class="pc-today-item"><b id="pc-late-count">0</b><small>En retard</small></div><div class="pc-today-item"><b id="pc-passport-count">0</b><small>Passeports</small></div><div class="pc-today-item"><b id="pc-message-count">0</b><small>Messages</small></div><div class="pc-today-item" onclick="open360()" style="cursor:pointer"><b><i class="fa-solid fa-shield-heart"></i></b><small>Prévention 360</small></div></div>';
m.insertBefore(box,m.children[1]||null);updateToday()}
function updateToday(){const reports=q('#manager-risk-box');const active=reports?reports.querySelectorAll('[data-report-id],.report-card,.risk-card').length:0;const code=(q('#lbl-manager-comp-name')?.innerText||'DEMO').trim();let records=[];try{records=JSON.parse(localStorage.getItem('m360_'+code)||'[]')}catch(e){}const today=new Date().toISOString().slice(0,10);const state=x=>x.values?.find(v=>/État/i.test(v.label))?.value||'À faire';const due=x=>x.values?.find(v=>/Échéance|Date du point|Prochaine revue|Date d’exercice/i.test(v.label))?.value||'';const closed=x=>/Clôtur|Testé/i.test(state(x));const set=(id,v)=>{const e=q(id);if(e)e.textContent=v};set('#pc-risk-count',active);set('#pc-action-count',records.filter(x=>!closed(x)).length);set('#pc-late-count',records.filter(x=>!closed(x)&&due(x)&&due(x)<today).length);set('#pc-passport-count',qa('#passport-registry-body tr').length);set('#pc-message-count',safeCount('restev85_messages'))}
function employeeSimple(){const e=q('#scr-employee');if(!e||q('#pc-employee-focus'))return;const box=document.createElement('section');box.id='pc-employee-focus';box.className='pc-employee-focus';box.innerHTML='<button onclick="switchScreen(\'scr-task\')"><i class="fa-solid fa-play"></i> Commencer une tâche</button><button onclick="switchScreen(\'scr-report\')"><i class="fa-solid fa-triangle-exclamation"></i> Signaler un danger</button><button onclick="switchScreen(\'scr-passport\')"><i class="fa-solid fa-id-card"></i> Mon passeport</button><button onclick="openEmployeeMessages()"><i class="fa-solid fa-envelope"></i> Mes messages</button><button onclick="switchScreen(\'scr-previa\')"><i class="fa-solid fa-comments"></i> Demander à PREV’IA</button>';
const anchor=e.children[1]||null;e.insertBefore(box,anchor);qa(':scope > *',e).forEach(x=>{if(x!==box&&x!==e.firstElementChild)x.classList.add('pc-advanced')});const t=document.createElement('button');t.className='pc-toggle';t.textContent='Afficher les fonctions complémentaires';t.onclick=()=>{e.classList.toggle('pc-show-advanced');t.textContent=e.classList.contains('pc-show-advanced')?'Masquer les fonctions complémentaires':'Afficher les fonctions complémentaires'};box.after(t)}
function redirectOld(){qa('#pst-home-btn,#pst-drawer-btn,#btn-pilotage').forEach(b=>{b.onclick=()=>window.open360?.();const strong=b.querySelector('b');if(strong)strong.textContent='Prévention 360'})}
function lazyLibraries(){window.prevyLoadChart=()=>import('https://cdn.jsdelivr.net/npm/chart.js/+esm');window.prevyLoadLeaflet=()=>Promise.resolve(window.L||null);window.prevyLoadQRCode=()=>Promise.resolve(window.QRCode||null)}
function init(){installSync();managerToday();employeeSimple();redirectOld();lazyLibraries();setInterval(updateToday,5000);console.log(VERSION,'actif')}
document.addEventListener('DOMContentLoaded',init);if(document.readyState!=='loading')setTimeout(init,0);
})();
(function(){
'use strict';
const ENDPOINT='https://kubqstzkdeqlsxgwfbpz.supabase.co/functions/v1/previa';
let busy=false;
const $=id=>document.getElementById(id);
function clean(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function add(role,text){const box=$('previa-chat');if(!box)return null;const d=document.createElement('div');d.className=role==='user'?'ml-8 bg-restev-blue text-white p-3 rounded-2xl text-xs':'mr-4 bg-slate-50 dark:bg-slate-900 border p-3 rounded-2xl text-xs dark:text-slate-200';d.innerHTML='<b>'+(role==='user'?'Vous':'PREV’IA')+' :</b> '+clean(text).replace(/\n/g,'<br>');box.appendChild(d);box.scrollTop=box.scrollHeight;return d;}
function state(text,thinking=false){const e=$('previa-status');if(e){e.textContent=text;e.classList.toggle('previa-thinking',thinking)}const b=$('previa-send-btn');if(b)b.disabled=thinking;}
function localHelp(q){const s=q.toLowerCase();if(/urgence|incendie|accident grave|inconscient|explosion|danger immédiat/.test(s))return 'Situation potentiellement urgente. Arrêtez-vous, mettez-vous en sécurité et appliquez immédiatement les consignes d’urgence de l’entreprise. Alertez les secours ou les personnes prévues. N’attendez pas une réponse de PREV’IA.';if(/escabeau|échelle|hauteur/.test(s))return 'Avant de commencer : vérifiez la stabilité, l’état du matériel, le sol, l’environnement et la possibilité d’utiliser un moyen plus sûr. Respectez les consignes de l’entreprise et demandez l’avis du responsable en cas de doute.';if(/machine|outil/.test(s))return 'Avant utilisation : vérifiez les protections, l’arrêt d’urgence, l’état de l’outil, les autorisations et la consigne de mise en sécurité. N’intervenez jamais sur une machine en mouvement.';return 'PREV’IA ne peut pas joindre le service en ligne. Décrivez la tâche, le danger observé et les protections en place à votre responsable. En cas de danger immédiat, arrêtez la tâche et appliquez la procédure interne.';}
async function token(){try{const r=await window.r85Supabase?.auth?.getSession?.();return r?.data?.session?.access_token||window.SUPABASE_ANON_KEY||SUPABASE_ANON_KEY}catch(e){return window.SUPABASE_ANON_KEY||SUPABASE_ANON_KEY}}
async function request(q){const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),15000);try{const t=await token();const res=await fetch(ENDPOINT,{method:'POST',mode:'cors',cache:'no-store',signal:controller.signal,headers:{'Content-Type':'application/json','apikey':window.SUPABASE_ANON_KEY||SUPABASE_ANON_KEY,'Authorization':'Bearer '+t},body:JSON.stringify({question:q,context:{employee:window.currentEmployeeSession?.name||'',company:window.currentEmployeeSession?.company||'',profile:window.currentEmployeeSession?.profile||'',sector:window.currentEmployeeSession?.sector||'',language:window.r85Language?.()||'fr',app:'PREVY'}})});const raw=await res.text();let data;try{data=raw?JSON.parse(raw):{}}catch(e){throw new Error('Réponse serveur non valide, HTTP '+res.status)}if(!res.ok)throw new Error(data.error||data.message||'HTTP '+res.status);return data.answer||data.response||data.text||''}finally{clearTimeout(timer)}}
window.openPrevia=function(){window.switchScreen?.('scr-previa');window.setPrevyState?.('accueil');state('PREV’IA est prêt');setTimeout(()=>$('previa-input')?.focus(),50)};
window.previaPrompt=function(type){const i=$('previa-input');if(!i)return;i.value={task:'Je commence une tâche : ',unsafe:'Je ne me sens pas en sécurité parce que ',risk:'Je souhaite analyser cette situation : '}[type]||'';i.focus()};
window.previaSend=async function(){if(busy)return;const i=$('previa-input');const q=(i?.value||'').trim();if(!q)return;busy=true;i.value='';add('user',q);const wait=add('ai','Analyse en cours...');state('PREV’IA réfléchit...',true);try{let answer=await request(q);if(!answer)throw new Error('Réponse vide');wait?.remove();add('ai',answer);window.setPrevyState?.('conseil');window.setPreviaLastAnswer?.(answer);window.speakPreviaAnswer?.(answer);state('Réponse reçue')}catch(e){wait?.remove();const answer=localHelp(q);add('ai',answer);window.setPrevyState?.(/urgence|danger immédiat/i.test(q)?'stop':'attention');state(e?.name==='AbortError'?'Service trop lent, réponse de secours affichée':'Service indisponible, réponse de secours affichée');console.error('PREVIA_CORE',e)}finally{busy=false;const b=$('previa-send-btn');if(b)b.disabled=false}};
function init(){const i=$('previa-input'),b=$('previa-send-btn');if(i&&!i.dataset.previaCore){i.dataset.previaCore='1';i.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();window.previaSend()}})}if(b)b.onclick=e=>{e.preventDefault();window.previaSend()};state('PREV’IA est prêt')}
document.addEventListener('DOMContentLoaded',init);if(document.readyState!=='loading')setTimeout(init,0);
})();
